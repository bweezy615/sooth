<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>co.sooth.capture</string>
  <key>ProgramArguments</key>
  <array><string>/Users/b/pick-engine/scripts/capture.sh</string></array>
  <key>StartInterval</key><integer>10800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/Users/b/pick-engine/data/capture/launchd.err</string>
  <key>StandardOutPath</key><string>/Users/b/pick-engine/data/capture/launchd.out</string>
</dict>
</plist>
